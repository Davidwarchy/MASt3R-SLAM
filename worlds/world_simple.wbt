DEF RbtWhse Robot {
  translation -2 -3 0
  rotation 0 0 1 3.14159
  children [
    DEF body Pose {
      translation 0 0 0.166
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0 0 1
