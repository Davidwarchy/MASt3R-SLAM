    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0.18 0 0.1
      }
      device [
        RotationalMotor {
          name "motor_1"
        }
      ]
      endPoint DEF wheel1_ Solid {
        translation 0.18 0 0.1
        rotation 0 1 0 1.5707963267948966
        children [
          DEF wheel Shape {
            appearance PBRAppearance {
              baseColor 1 0 0
              roughness 1
              metalness 0
            }
            geometry Cylinder {
              height 0.04
              radius 0.1
            }
          }
        ]
        boundingObject USE wheel
        physics DEF wheel_physics Physics {
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor -0.18 0 0.1
      }
      device [
        RotationalMotor {
          name "motor_2"
        }
      ]
      endPoint DEF wheel4_ Solid {
        translation -0.18 -0.0005252487504726964 0.10003918237593952
        rotation 0.562784399657833 0.6058478231690909 0.5623363181078084 2.051469975905846
        children [
          USE wheel
        ]
        name "wheel4_"
        boundingObject USE wheel
        physics USE wheel_physics
      }
    }
    Solid {
      translation 0.06 -0.18 0.28
      children [
        DEF eye Shape {
          appearance PBRAppearance {
            baseColor 1 0 0
            roughness 1
          }
          geometry Box {
            size 0.02 0.02 0.02
          }
        }
      ]
      name "eye_1"
    }
    Solid {
      translation -0.06 -0.18 0.28
      children [
        USE eye
      ]
      name "eye_2"
    }
    Pose {
      translation 0 0 0.32
      children [
        InertialUnit {
          rotation 0 0 1 -1.5707996938995747
          name "imu"
          description "i"
        }
